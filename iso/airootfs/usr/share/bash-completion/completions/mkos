# bash completion for the `mkos` meta-command.
# Subcommands are discovered from mkos-* binaries on PATH, so this also
# picks up any third-party mkos-* tools that get installed later.

_mkos() {
    local cur prev subs
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Top level: list subcommand stems
    if [ "$COMP_CWORD" -eq 1 ]; then
        # discover every `mkos-<name>` on PATH; strip the prefix once
        subs=$(compgen -c mkos- | sed 's/^mkos-//' | sort -u)
        COMPREPLY=( $(compgen -W "$subs help" -- "$cur") )
        return 0
    fi

    # Delegate deeper completions to the underlying binary when it advertises
    # one. Fall back to plain filename completion otherwise.
    local sub="${COMP_WORDS[1]}"
    if declare -F "_mkos-$sub" >/dev/null 2>&1; then
        "_mkos-$sub"
    else
        COMPREPLY=( $(compgen -f -- "$cur") )
    fi
}

complete -F _mkos mkos
