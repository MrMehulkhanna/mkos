#!/usr/bin/env bash
# ============================================================================
#  mkos-audio — inspect, unmute, and configure audio output and input
#
#    mkos-audio status     show active audio sinks, sources, and volume
#    mkos-audio unmute     unmute all channels (speakers, mic) and set volume
#    mkos-audio reset      restart PipeWire & WirePlumber user services
#    mkos-audio list       speakers: NAME<TAB>DESCRIPTION
#    mkos-audio together NAME...   play on several speakers at once, in sync
#    mkos-audio all        every connected speaker together, in sync
#    mkos-audio single     back to one speaker
#
#  "together" uses PipeWire's combine-stream with latency compensation: every
#  speaker reports how far behind it plays (HDMI buffers more than the
#  laptop's own speaker, Bluetooth far more) and the faster ones are held
#  back by the difference, so they all sound at the same moment. It shows up
#  as one output, "All selected speakers", made the default.
# ============================================================================
set -euo pipefail

TOGETHER_CONF="$HOME/.config/mkos/audio-together.conf"
TOGETHER_SINK="mkos-together"

list_sinks() {
    pactl -f json list sinks 2>/dev/null | python3 -c '
import json, sys
for s in json.load(sys.stdin):
    if s["name"] != "mkos-together":
        print(s["name"] + "\t" + s.get("description", s["name"]))'
}

restart_audio() {
    systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null || true
    local i
    for i in $(seq 1 30); do pactl info >/dev/null 2>&1 && break; sleep 0.2; done
}

case "${1:-status}" in
    status)
        echo "=== Audio Sinks & Sources ==="
        wpctl status 2>/dev/null | sed -n '/Audio/,/Video/p' || pactl list sinks short 2>/dev/null || true
        ;;
    unmute)
        for c in Master Speaker Headphone Mic "Capture" "Internal Mic"; do
            amixer -q set "$c" unmute 2>/dev/null || true
            amixer -q set "$c" 80% 2>/dev/null || true
        done
        default_sink=$(wpctl status 2>/dev/null | grep -E '\*\s+[0-9]+\.' | head -1 | awk '{print $2}' | tr -d '.' || true)
        if [ -n "$default_sink" ]; then
            wpctl set-mute "$default_sink" 0 2>/dev/null || true
            wpctl set-volume "$default_sink" 0.8 2>/dev/null || true
        fi
        echo "Audio channels unmuted and set to 80% volume."
        ;;
    reset)
        systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null || true
        sleep 1
        "$0" unmute
        echo "PipeWire and WirePlumber restarted and unmuted."
        ;;
    list)
        list_sinks
        ;;
    all)
        # every speaker that is really connected — skips outputs whose port
        # reports nothing plugged in (unused HDMI/DisplayPort sockets)
        mapfile -t every < <(pactl -f json list sinks 2>/dev/null | python3 -c '
import json, sys
for s in json.load(sys.stdin):
    if s["name"].startswith("mkos-"):
        continue
    ports = {p["name"]: p.get("availability", "") for p in s.get("ports", [])}
    if ports and ports.get(s.get("active_port") or "", "") == "not available":
        continue
    print(s["name"])')
        [ ${#every[@]} -ge 2 ] || { echo "only one speaker is connected" >&2; exit 1; }
        exec "$0" together "${every[@]}"
        ;;
    together)
        shift
        [ $# -ge 2 ] || { echo "pick at least two speakers (mkos-audio list)" >&2; exit 1; }
        known=$(list_sinks | cut -f1)
        rules=""
        for n in "$@"; do
            grep -qxF "$n" <<<"$known" || { echo "no speaker called $n" >&2; exit 1; }
            rules+="        { matches = [ { media.class = \"Audio/Sink\" node.name = \"$n\" } ] actions = { create-stream = { } } }"$'\n'
        done
        # Its own small PipeWire process, not a drop-in for the main one:
        # loading it into the main daemon needed a restart of the sound
        # system, and every app already open (browser, Claude...) lost its
        # microphone and speakers until it was restarted itself.
        mkdir -p "${TOGETHER_CONF%/*}"
        rm -f "$HOME/.config/pipewire/pipewire.conf.d/90-mkos-together.conf"
        {
            echo '# written by mkos-audio: one output that plays on several speakers in sync'
            echo 'context.properties = { log.level = 0 }'
            echo 'context.spa-libs = { audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }'
            echo 'context.modules = ['
            echo '  { name = libpipewire-module-rt args = { nice.level = -11 } flags = [ ifexists nofail ] }'
            echo '  { name = libpipewire-module-protocol-native }'
            echo '  { name = libpipewire-module-client-node }'
            echo '  { name = libpipewire-module-adapter }'
            echo '  { name = libpipewire-module-combine-stream'
            echo '    args = {'
            echo '      combine.mode = sink'
            echo "      node.name = \"$TOGETHER_SINK\""
            echo '      node.description = "All selected speakers"'
            echo '      combine.latency-compensate = true'
            echo '      combine.props = { audio.position = [ FL FR ] }'
            echo '      stream.props = { stream.dont-remix = true }'
            echo '      stream.rules = ['
            printf '%s' "$rules"
            echo '      ]'
            echo '    }'
            echo '  }'
            echo ']'
        } > "$TOGETHER_CONF"
        pkill -f "pipewire -c $TOGETHER_CONF" 2>/dev/null || true
        setsid pipewire -c "$TOGETHER_CONF" >/dev/null 2>&1 &
        for _ in $(seq 1 25); do pactl list short sinks | grep -q "$TOGETHER_SINK" && break; sleep 0.2; done
        pactl set-default-sink "$TOGETHER_SINK" 2>/dev/null \
            || { echo "PipeWire did not create the combined output" >&2; exit 1; }
        # each speaker at full, so the one volume slider (the combined output)
        # sets the loudness; otherwise a speaker left at 40 % capped it there
        for n in "$@"; do
            pactl set-sink-volume "$n" 100% 2>/dev/null || true
            pactl set-sink-mute "$n" 0 2>/dev/null || true
        done
        # if a screen share is sending sound, its in-step delay fed the old
        # combined output; hook it onto the new one
        if [ -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mkos-share/delay.pid" ] && command -v mkos-share >/dev/null; then
            mkos-share audio-delay "$(cat "$HOME/.config/mkos/share-audio-delay-ms" 2>/dev/null || echo 60)" >/dev/null 2>&1 || true
        fi
        echo "Playing on $# speakers together, in sync."
        touch "$HOME/.config/mkos/audio-together" 2>/dev/null || { mkdir -p "$HOME/.config/mkos"; touch "$HOME/.config/mkos/audio-together"; }
        ;;
    single)
        pkill -f "pipewire -c $TOGETHER_CONF" 2>/dev/null || true
        rm -f "$TOGETHER_CONF" "$HOME/.config/mkos/audio-together"
        echo "Back to one speaker."
        ;;
    restore)
        # at login: something (a device appearing, an app) can pick another
        # default; put the combined output back if the user chose it
        [ -f "$HOME/.config/mkos/audio-together" ] && [ -f "$TOGETHER_CONF" ] || exit 0
        pgrep -f "pipewire -c $TOGETHER_CONF" >/dev/null || { setsid pipewire -c "$TOGETHER_CONF" >/dev/null 2>&1 & }
        for _ in $(seq 1 50); do pactl list short sinks 2>/dev/null | grep -q "$TOGETHER_SINK" && break; sleep 0.2; done
        pactl set-default-sink "$TOGETHER_SINK" 2>/dev/null || true
        ;;
    delay)
        # mkos-audio delay NAME MS: a speaker that plays late by itself (a
        # monitor processing its sound) reports no such delay; tell PipeWire,
        # and the combined output holds the others back to match it
        sink="${2:-}"; ms="${3:-0}"
        card=$(pactl -f json list sinks | python3 -c "import json,sys
s=[x for x in json.load(sys.stdin) if x['name']=='$sink']
print(s[0]['properties'].get('device.name','') + ' ' + (s[0].get('active_port') or '') if s else '')")
        [ -n "${card// }" ] || { echo "no speaker called $sink" >&2; exit 1; }
        pactl set-port-latency-offset ${card% *} ${card#* } $(( ms * 1000 ))
        echo "$sink now treated as $ms ms late."
        ;;
    -h|--help|help)
        echo "Usage: mkos-audio {status|unmute|reset|list|all|together NAME...|single}"
        ;;
    *)
        echo "Usage: mkos-audio {status|unmute|reset|list|all|together NAME...|single}"
        exit 1
        ;;
esac
