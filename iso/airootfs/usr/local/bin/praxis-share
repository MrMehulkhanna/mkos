#!/usr/bin/env bash
# praxis-share — use another machine's screen as a display of this one.
#
#   praxis-share extend [--res WxH@Hz] [--port N] [--no-audio]
#                                                  add a virtual monitor and serve it
#   praxis-share mirror [--output NAME] [--port N]  serve an existing monitor instead
#   praxis-share connect HOST[:PORT]                show a served screen on this machine
#   praxis-share input host [--side right]          share this keyboard and mouse
#   praxis-share input join HOST                    take this machine's input from HOST
#   praxis-share input stop                         stop sharing input
#   praxis-share stop                               stop serving, remove the virtual monitor
#   praxis-share status                             what is being served, and to whom
#   praxis-share doctor                             what is missing before this will work
#
# Extend vs mirror is a real distinction here. `mirror` sends a copy of a
# monitor you already have. `extend` asks Hyprland for a headless output,
# which it treats as a genuine third display with its own workspaces — so
# laptop panel, plugged-in monitor and a remote laptop can all be separate
# screens at once.
#
# On latency: capture -> encode -> network -> decode -> present costs roughly
# 15-40 ms on a good LAN, and this reports the measured figure rather than
# claiming otherwise. That is comfortable for a browser, a terminal or
# reference material on the far screen. It is not good enough for games or
# scrubbing video there, and no amount of tuning makes a network hop free.
set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/praxis-share"
PID_FILE="$STATE_DIR/capture.pid"
SERVE_PID_FILE="$STATE_DIR/serve.pid"
FIFO="$STATE_DIR/stream.ts"
GATE_PID_FILE="$STATE_DIR/gate.pid"
CODE_FILE="$STATE_DIR/code"
# TEMPORARY while the two-laptop link is being tuned: no pairing code. Both
# sides use this fixed key, so a click on the PC in the list connects with
# nothing to type. The link is still encrypted; it is just open to anyone on
# the same network. Set PRAXIS_SHARE_PIN=1 to bring the four-digit code back.
OPEN_CODE="0000"
new_code() { if [ "${PRAXIS_SHARE_PIN:-0}" = 1 ]; then praxis-share-gate newcode; else echo "$OPEN_CODE"; fi; }
MON_FILE="$STATE_DIR/monitor"
PORT_FILE="$STATE_DIR/port"
DEFAULT_PORT=5920
DEFAULT_RES="1920x1080@60"
WITH_AUDIO=1          # send sound with the picture unless told not to
# "praxis-share sound off" keeps the sound on this PC's own speakers only
[ "$(cat "$HOME/.config/praxis/share-sound" 2>/dev/null)" = off ] && WITH_AUDIO=0

die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[36m•\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }

need() { command -v "$1" >/dev/null || die "$1 is not installed — run: praxis-share doctor"; }

mkdir -p "$STATE_DIR"

# ── capability check ────────────────────────────────────────────────────
doctor() {
    local missing=0
    printf '\n\033[1mpraxis-share requirements\033[0m\n\n'
    check() {
        if eval "$2" >/dev/null 2>&1; then printf '  \033[32m✓\033[0m %-34s %s\n' "$1" "${3:-}"
        else printf '  \033[31m✗\033[0m %-34s \033[2m%s\033[0m\n' "$1" "${4:-missing}"; missing=1; fi
    }
    check "Hyprland running"         'hyprctl version'
    # These are what the pipeline actually uses. The list used to name
    # matroskamux and pipewiresrc, which it stopped using when capture moved
    # to wf-recorder and the container to mpegts — so it reported things
    # missing that are not needed, and never checked the ones that are.
    check "wf-recorder (capture)"    'command -v wf-recorder'          "" "pacman -S wf-recorder"
    check "ffmpeg (encoding)"        'command -v ffmpeg'               "" "pacman -S ffmpeg"
    check "gstreamer"                'command -v gst-launch-1.0'       "" "pacman -S gstreamer gst-plugins-base"
    check "tcpserversink"            'gst-inspect-1.0 tcpserversink'   "" "pacman -S gst-plugins-base"
    check "tsdemux"                  'gst-inspect-1.0 tsdemux'         "" "pacman -S gst-plugins-bad"
    check "h264parse"                'gst-inspect-1.0 h264parse'       "" "pacman -S gst-plugins-bad"
    check "waylandsink (viewer)"     'gst-inspect-1.0 waylandsink'     "" "pacman -S gst-plugins-bad"
    check "aacparse"                 'gst-inspect-1.0 aacparse'        "" "pacman -S gst-plugins-good"
    check "pulsesink (sound out)"    'gst-inspect-1.0 pulsesink'       "" "pacman -S gst-plugins-good"
    check "h264 decoder"             'gst-inspect-1.0 avdec_h264'      "" "pacman -S gst-libav"
    check "h265 decoder"             'gst-inspect-1.0 avdec_h265'      "" "pacman -S gst-libav"
    check "aac decoder"              'gst-inspect-1.0 avdec_aac'       "" "pacman -S gst-libav"
    check "pairing gate"             'command -v praxis-share-gate'    "" "reinstall praxis"

    local enc=""
    for e in nvh264enc vah264enc x264enc; do
        if gst-inspect-1.0 "$e" >/dev/null 2>&1; then enc="$e"; break; fi
    done
    if [ -n "$enc" ]; then
        printf '  \033[32m✓\033[0m %-34s %s\n' "h264 encoder" "$enc$([ "$enc" = nvh264enc ] && echo '  (hardware, NVENC)')"
    else
        printf '  \033[31m✗\033[0m %-34s \033[2m%s\033[0m\n' "h264 encoder" "pacman -S gst-plugins-bad gst-plugins-ugly"; missing=1
    fi

    printf '\n'
    [ "$missing" -eq 0 ] && ok "ready" || info "install what is marked above, then run this again"
    return 0
}

encoder() {
    # Test-encode, don't just ask ffmpeg what it was built with. ffmpeg lists
    # h264_nvenc on every Arch machine, NVIDIA or not, and even on an NVIDIA
    # laptop it stops working between a driver update and the next reboot.
    # Picking a listed-but-dead encoder killed the capture the moment a viewer
    # connected, so the viewer said "connected" and never showed a picture.
    # libx264 is the software fallback that always works.
    # HEVC 4:4:4 comes first: at 30 Mb/s it measured SSIM 0.997 against a
    # lossless copy on a moving test pattern, where H.264 4:4:4 made about 30%
    # more errors at the same bitrate, and NVIDIA GPUs from Turing on decode
    # it in hardware. The test encode uses the real 4:4:4 settings, because a
    # GPU can encode HEVC and still refuse its 4:4:4 profile.
    local e
    if ffmpeg -hide_banner -loglevel error -f lavfi -i nullsrc=s=256x144:r=30 \
           -frames:v 3 -pix_fmt bgr0 -c:v hevc_nvenc -profile:v rext -rgb_mode yuv444 -f null - >/dev/null 2>&1; then
        echo hevc_nvenc; return
    fi
    for e in h264_nvenc libx264; do
        if ffmpeg -hide_banner -loglevel error -f lavfi -i nullsrc=s=256x144:r=30 \
               -frames:v 3 -c:v "$e" -f null - >/dev/null 2>&1; then
            echo "$e"; return
        fi
    done
    die "no working h264 encoder — run: praxis-share doctor"
}

# Low latency matters more than compression ratio here: a big keyframe gap
# means a late joiner stares at nothing, and lookahead/B-frames trade delay
# for bitrate we do not need on a LAN.
encoder_args() {
    case "$1" in
        # NVENC's tune is an enum of its own (hq/ll/ull/lossless) — it does
        # not take x264's "zerolatency", and rejects the whole encoder when
        # handed it. ull is the ultra-low-latency profile we want here.
        # rgb_mode=yuv444: NVENC converts the captured RGB to full 4:4:4
        # itself, in TV range with the BT.601 matrix, which the tags match.
        h264_nvenc) echo "preset=p1 tune=ull g=30 rc=cbr b=${SHARE_BITRATE:-30M} profile=high444p rgb_mode=yuv444 colorspace=smpte170m color_primaries=bt709 color_trc=iec61966-2-1 color_range=tv" ;;
        hevc_nvenc) echo "preset=p1 tune=ull g=30 bf=0 rc=cbr b=${SHARE_BITRATE:-30M} profile=rext rgb_mode=yuv444 colorspace=smpte170m color_primaries=bt709 color_trc=iec61966-2-1 color_range=tv" ;;
        h264_vaapi) echo "g=30 b=12M" ;;
        *)          echo "preset=ultrafast tune=zerolatency g=30 b=${SHARE_BITRATE_SW:-16M} colorspace=smpte170m color_primaries=bt709 color_trc=iec61966-2-1 color_range=pc" ;;
    esac
}

monitors() { hyprctl -j monitors 2>/dev/null; }

# The monitor of the default sink is "what this machine is playing". Capturing
# it into the same container as the video is what keeps sound with picture:
# one set of timestamps, one muxer, nothing to drift apart.
default_monitor() {
    local sink; sink=$(pactl get-default-sink 2>/dev/null) || return 1
    [ -n "$sink" ] && echo "${sink}.monitor"
}

serving_pid() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        cat "$PID_FILE"
    elif [ -f "$GATE_PID_FILE" ] && kill -0 "$(cat "$GATE_PID_FILE")" 2>/dev/null; then
        cat "$GATE_PID_FILE"
    fi
}

# ── host: add a virtual monitor ─────────────────────────────────────────
add_headless() {
    local before after new
    before=$(monitors | python3 -c 'import json,sys;print(" ".join(m["name"] for m in json.load(sys.stdin)))')
    hyprctl output create headless >/dev/null || die "Hyprland refused to create a headless output"
    sleep 0.6
    after=$(monitors | python3 -c 'import json,sys;print(" ".join(m["name"] for m in json.load(sys.stdin)))')
    for n in $after; do case " $before " in *" $n "*) ;; *) new="$n" ;; esac; done
    [ -n "${new:-}" ] || die "the headless output did not appear"
    # Hyprland gives a new headless output the default scale of 2, so a
    # 1920x1080 display was really 960x540 stretched — blurry text and huge
    # windows on the far screen. Pin it to scale 1 at the requested mode.
    local res; res=$(cat "$STATE_DIR/res" 2>/dev/null || true); [ -n "$res" ] || res="$DEFAULT_RES"
    hyprctl eval "hl.monitor({ output = \"$new\", mode = \"$res\", position = \"auto\", scale = $(cat "$STATE_DIR/scale" 2>/dev/null || echo 1) })" >/dev/null 2>&1 || true
    place_shared "$new" >/dev/null 2>&1 || true
    # a live wallpaper drawn on every screen would cover this one too and
    # keep its picture changing every frame; re-apply it on real screens only
    pgrep -x mpvpaper >/dev/null && command -v praxis-wallpaper >/dev/null \
        && { praxis-wallpaper restore --force >/dev/null 2>&1 & }
    echo "$new"
}

cmd_extend() {
    local res="$DEFAULT_RES" port="$DEFAULT_PORT"
    while [ $# -gt 0 ]; do case "$1" in
        --res)  res="$2";  shift 2 ;;
        --port) port="$2"; shift 2 ;;
        --no-audio) WITH_AUDIO=0; shift ;;
        --audio) WITH_AUDIO=1; shift ;;
        *) die "unknown option: $1" ;;
    esac; done
    [ -z "$(serving_pid)" ] || die "already serving — stop it first:  praxis-share stop"
    need hyprctl
    mkdir -p "$STATE_DIR"
    echo "extend" > "$STATE_DIR/mode"
    echo "$res" > "$STATE_DIR/res"
    echo "$WITH_AUDIO" > "$STATE_DIR/with_audio"
    echo "$port" > "$PORT_FILE"
    rm -f "$MON_FILE"

    local inner=$(( port + 1000 ))
    local code; code=$(new_code)
    printf '%s\n' "$code" > "$CODE_FILE"; chmod 600 "$CODE_FILE"
    setsid praxis-share-gate serve --listen "$port" --to "$inner" --code "$code" \
        --on-connect "praxis-share on-connect-stream" \
        >"$STATE_DIR/gate.log" 2>&1 &
    echo $! > "$GATE_PID_FILE"
    sleep 1
    if ! kill -0 "$(cat "$GATE_PID_FILE")" 2>/dev/null; then
        die "gate did not start — see $STATE_DIR/gate.log"
    fi
    ok "serving on port $port"
    printf '\n  \033[1mpairing code  %s\033[0m\n' "$code"
    info "extra screen will appear to the right when a viewer connects"
}

cmd_mirror() {
    local out="" port="$DEFAULT_PORT"
    while [ $# -gt 0 ]; do case "$1" in
        --output) out="$2";  shift 2 ;;
        --port)   port="$2"; shift 2 ;;
        --no-audio) WITH_AUDIO=0; shift ;;
        --audio) WITH_AUDIO=1; shift ;;
        *) die "unknown option: $1" ;;
    esac; done
    [ -z "$(serving_pid)" ] || die "already serving — stop it first:  praxis-share stop"
    [ -n "$out" ] || out=$(monitors | python3 -c 'import json,sys;ms=json.load(sys.stdin);print(ms[0]["name"] if ms else "")')
    [ -n "$out" ] || die "no monitor to mirror"
    mkdir -p "$STATE_DIR"
    echo "mirror" > "$STATE_DIR/mode"
    echo "$out" > "$STATE_DIR/mirror_out"
    echo "$WITH_AUDIO" > "$STATE_DIR/with_audio"
    echo "$port" > "$PORT_FILE"
    : > "$MON_FILE"            # nothing to remove on stop: it is a real monitor

    local inner=$(( port + 1000 ))
    local code; code=$(new_code)
    printf '%s\n' "$code" > "$CODE_FILE"; chmod 600 "$CODE_FILE"
    setsid praxis-share-gate serve --listen "$port" --to "$inner" --code "$code" \
        --on-connect "praxis-share on-connect-stream" \
        >"$STATE_DIR/gate.log" 2>&1 &
    echo $! > "$GATE_PID_FILE"
    sleep 1
    if ! kill -0 "$(cat "$GATE_PID_FILE")" 2>/dev/null; then
        die "gate did not start — see $STATE_DIR/gate.log"
    fi
    ok "mirroring $out on port $port"
    printf '\n  \033[1mpairing code  %s\033[0m\n' "$code"
}

cmd_on_connect_stream() {
    # Called by the gate when the first viewer completes TLS handshake
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "PRAXIS-CODEC $(cat "$STATE_DIR/codec" 2>/dev/null || echo h264)"
        return 0
    fi
    local mode; mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "extend")
    local mon=""
    # the viewer named its own screen during pairing: build the extra display
    # at exactly that size, so nothing is stretched on the far side
    if [ -n "${PRAXIS_SHARE_RES:-}" ]; then
        echo "$PRAXIS_SHARE_RES" > "$STATE_DIR/res"
        # The user's own choice for the shared screen wins. Otherwise match
        # sizes: from the viewer's physical width, pick the scale that makes
        # text, windows and the cursor on it the same size in millimetres as
        # on this PC's own screen (its built-in panel, else the first one).
        # Copying the viewer's own scale did not: a 15" 1080p panel at 100 %
        # sat next to a sharp laptop at 200 % with everything a different size.
        if [ -s "$HOME/.config/praxis/share-scale" ]; then
            cat "$HOME/.config/praxis/share-scale" > "$STATE_DIR/scale"
        else
            match=$(monitors | python3 -c '
import json, sys
w, mm = int(sys.argv[1]), int(sys.argv[2])
ms = [m for m in json.load(sys.stdin) if not m["name"].startswith("HEADLESS") and m.get("physicalWidth")]
ref = next((m for m in ms if m["name"].startswith("eDP")), ms[0] if ms else None)
if not ref or mm <= 0: sys.exit(1)
per_mm = (ref["width"] / ref["scale"]) / ref["physicalWidth"]
s = round((w / mm) / per_mm * 4) / 4
print(min(3, max(1, s)))' "${PRAXIS_SHARE_RES%%x*}" "${PRAXIS_SHARE_MM:-0}" 2>/dev/null) \
                && echo "$match" > "$STATE_DIR/scale" || echo "${PRAXIS_SHARE_SCALE:-1}" > "$STATE_DIR/scale"
        fi
        info "viewer screen is $PRAXIS_SHARE_RES at scale ${PRAXIS_SHARE_SCALE:-1}"
    fi
    # The extra display and mouse sharing would both claim the same screen
    # edge. While a viewer shows this PC's screen, the pointer already
    # reaches that PC through the picture, so mouse sharing pauses and comes
    # back when sharing stops.
    command -v praxis-mouse >/dev/null && praxis-mouse pause >/dev/null 2>&1 || true
    if [ "$mode" = "extend" ]; then
        if [ -s "$MON_FILE" ] && monitors | grep -q "\"$(cat "$MON_FILE")\""; then
            mon=$(cat "$MON_FILE")
            hyprctl eval "hl.monitor({ output = \"$mon\", mode = \"$(cat "$STATE_DIR/res" 2>/dev/null || echo "$DEFAULT_RES")\", position = \"auto\", scale = $(cat "$STATE_DIR/scale" 2>/dev/null || echo 1) })" >/dev/null 2>&1 || true
        else
            mon=$(add_headless)
            echo "$mon" > "$MON_FILE"
            ok "added $mon as a new display"
        fi
    else
        mon=$(cat "$STATE_DIR/mirror_out" 2>/dev/null || true)
        [ -n "$mon" ] || mon=$(monitors | python3 -c 'import json,sys;ms=json.load(sys.stdin);print(ms[0]["name"] if ms else "")')
    fi
    # Over Wi-Fi the picture has to fit ~30 Mb/s and live with jitter. Over a
    # cable — Ethernet, or a Thunderbolt/USB4 network link — there is room
    # for three times that, which takes the last of the blockiness out.
    # Decide from the interface the viewer is actually reached through.
    local peer=${PRAXIS_SHARE_PEER:-} dev=""
    [ -n "$peer" ] && dev=$(ip route get "$peer" 2>/dev/null | grep -oE 'dev [^ ]+' | awk '{print $2}' | head -1)
    # Bitrate follows the picture size: 30 Mb/s is near lossless for a
    # 1080p screen, so a 2880x1620 one (2.25x the pixels) gets ~70.
    local res w h px=2073600; res=$(cat "$STATE_DIR/res" 2>/dev/null || true)
    if [[ "$res" =~ ^([0-9]+)x([0-9]+) ]]; then w=${BASH_REMATCH[1]}; h=${BASH_REMATCH[2]}; px=$(( w * h )); fi
    SHARE_BITRATE="$(( (px * 15 + 999999) / 1000000 ))M"
    [ "${SHARE_BITRATE%M}" -lt 30 ] && SHARE_BITRATE=30M
    case "$dev" in
        wl*|"") ;;
        *) SHARE_BITRATE="$(( ${SHARE_BITRATE%M} * 3 > 150 ? 150 : ${SHARE_BITRATE%M} * 3 ))M"; SHARE_BITRATE_SW=40M
           info "wired link to $peer ($dev) — higher quality" ;;
    esac
    local port; port=$(cat "$PORT_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
    # the capture died (or never started): clear its server too, or the old
    # one keeps the loopback port and the new one cannot serve anything
    if [ -f "$SERVE_PID_FILE" ]; then kill "$(cat "$SERVE_PID_FILE")" 2>/dev/null || true; fi
    local with_audio; with_audio=$(cat "$STATE_DIR/with_audio" 2>/dev/null || echo "1")
    WITH_AUDIO="$with_audio"
    # stream at the viewer's refresh rate (sent at pairing, up to 120 Hz):
    # a 165 Hz laptop fed 60 fps showed the cursor moving in visible steps
    local hz=60 r; r=$(cat "$STATE_DIR/res" 2>/dev/null || true)
    [[ "$r" =~ @([0-9]+) ]] && hz=${BASH_REMATCH[1]}
    [ "$hz" -gt 120 ] && hz=120; [ "$hz" -lt 30 ] && hz=60
    start_stream "$mon" "$port" "$hz"
    # the viewer draws the pointer itself; send it where ours is
    if [ "$mode" = extend ] && [ -n "${PRAXIS_SHARE_PEER:-}" ]; then
        [ -f "$STATE_DIR/cursor.pid" ] && kill "$(cat "$STATE_DIR/cursor.pid")" 2>/dev/null || true
        setsid praxis-share-gate cursor-send --peer "$PRAXIS_SHARE_PEER" --output "$mon" \
            >"$STATE_DIR/cursor.log" 2>&1 &
        echo $! > "$STATE_DIR/cursor.pid"
    fi
    echo "PRAXIS-CODEC $(cat "$STATE_DIR/codec" 2>/dev/null || echo h264)"
}

start_stream() {
    local mon="$1" port="$2" fps="${3:-60}" enc
    local inner=$(( port + 1000 ))   # loopback-only; the gate fronts "$port"
    need wf-recorder; need gst-launch-1.0
    enc=$(encoder)
    # Software x264 at 1080p60 costs about three CPU cores; at 30 it is half
    # that and still smooth for documents, browsers and terminals. Hardware
    # encoders keep 60.
    [ "$enc" = libx264 ] && [ "$fps" -gt 30 ] && fps=30
    # NVENC on a laptop RTX 4050 encodes 4:4:4 at ~107 fps for 1920x1080 but
    # only ~49 for 2880x1620. Asking for more than it can do does not drop
    # frames cleanly: they queue, and the queue is input delay. Keep full
    # colour and ask for what the chip sustains, with a little headroom
    # (~250 Mpixel/s: 120 fps at 1080p, ~53 at 2880x1620), never above 120.
    case "$enc" in *_nvenc)
        local res; res=$(cat "$STATE_DIR/res" 2>/dev/null || true)
        if [[ "$res" =~ ^([0-9]+)x([0-9]+) ]]; then
            local cap=$(( ${SHARE_PIXEL_BUDGET:-250000000} / (BASH_REMATCH[1] * BASH_REMATCH[2]) ))
            [ "$cap" -lt "$fps" ] && fps=$cap
            [ "$fps" -lt 30 ] && fps=30
        fi ;;
    esac
    echo "$port" > "$PORT_FILE"

    rm -f "$FIFO"; mkfifo "$FIFO"

    info "capturing $mon with $enc$(case $enc in *_nvenc) echo ' (hardware)';; esac)"
    # each tuning flag needs its own -p, so expand them into an argv array
    local -a pargs=(); local kv
    for kv in $(encoder_args "$enc"); do pargs+=(-p "$kv"); done

    local -a aargs=()
    if [ "$WITH_AUDIO" = 1 ]; then
        local src; src=$(default_monitor || true)
        if [ -n "$src" ]; then
            aargs=(--audio="$src" --audio-backend=pulse -C aac)
            info "audio: $(printf '%s' "$src" | sed 's/^alsa_output\.//; s/\.monitor$//')"
        else
            info "no audio source found — video only"
        fi
    fi

    # Full 4:4:4 colour on the hardware encoder. Ordinary 4:2:0 video keeps a
    # quarter of the colour detail, which is fine for film and smears text,
    # thin lines and coloured edges — measured on a real screenshot, SSIM went
    # from 0.905 (4:2:0, 12 Mb/s) to 0.982 (4:4:4, 30 Mb/s), PSNR 43.8 -> 52 dB.
    # The software fallback stays 4:2:0 to keep its CPU cost down.
    local -a fmtargs=()
    case "$enc" in
        # The GPU does the RGB -> YUV 4:4:4 conversion inside NVENC
        # (rgb_mode=yuv444): the screen goes in as captured. Doing it on the
        # CPU first cost 1-3 cores, could not keep up at high resolution or
        # 120 Hz, and the frames queuing behind it were 150 ms+ of input
        # delay. The GPU path also measured better: 54 dB on the test card
        # against 47.7 for the most accurate CPU conversion.
        *_nvenc) fmtargs=(-x bgr0) ;;
        # Software fallback: accurate rounding and full-resolution chroma,
        # or swscale's fast defaults bleed colour across neighbouring pixels
        # (20 dB -> 59 dB on 1-pixel lines and small coloured text).
        *) fmtargs=(-F "scale=flags=accurate_rnd+full_chroma_int+full_chroma_inp:out_color_matrix=bt601:out_range=pc") ;;
    esac
    if [ "$enc" = hevc_nvenc ] && gst-inspect-1.0 nvh265enc >/dev/null 2>&1 \
       && gst-inspect-1.0 cudaconvert >/dev/null 2>&1; then
        start_stream_gst "$mon" "$inner" "$fps"; return
    fi
    case "$enc" in hevc*) echo hevc ;; *) echo h264 ;; esac > "$STATE_DIR/codec"
    setsid wf-recorder -y -D -o "$mon" -c "$enc" -m mpegts -r "$fps" "${fmtargs[@]}" \
        "${pargs[@]}" "${aargs[@]}" -f "$FIFO" >"$STATE_DIR/capture.log" 2>&1 &
    echo $! > "$PID_FILE"

    # No leaky queue on this side. Dropping part of an H.264 stream corrupts
    # every frame until the next keyframe — the blocky "bursting" picture.
    setsid gst-launch-1.0 -q \
        filesrc location="$FIFO" \
        ! tcpserversink host=127.0.0.1 port="$inner" sync=false \
        >"$STATE_DIR/serve.log" 2>&1 &
    echo $! > "$SERVE_PID_FILE"
}

# The far PC plays the shared sound a little after this one does (capture
# buffer, network, its own playback buffer), which sounded like an echo
# with both sets of speakers going. While sound is shared, this PC plays
# through a delay of the same length — a PipeWire loopback that becomes the
# default output — so every speaker sounds at once. The far PC is sent the
# sound before the delay (the loopback's monitor), so it is not delayed
# twice. Length: ~/.config/praxis/share-audio-delay-ms (default 60, the
# measured length of the far side's sound path on a cable).
DELAY_PID_FILE="$STATE_DIR/delay.pid"
delay_local_on() {
    command -v pw-loopback >/dev/null || return 0
    [ -f "$DELAY_PID_FILE" ] && kill -0 "$(cat "$DELAY_PID_FILE")" 2>/dev/null && return 0
    local ms orig
    ms=$(cat "$HOME/.config/praxis/share-audio-delay-ms" 2>/dev/null || echo 60)
    orig=$(pactl get-default-sink 2>/dev/null)
    [ -n "$orig" ] && [ "$orig" != praxis-delayed ] || return 0
    echo "$orig" > "$STATE_DIR/delay.orig"
    setsid pw-loopback -d "$(awk "BEGIN{print $ms/1000}")" \
        -i "media.class=Audio/Sink node.name=praxis-delayed node.description=Speakers-in-step-with-the-shared-screen" \
        -o "target.object=$orig node.dont-reconnect=true" >"$STATE_DIR/delay.log" 2>&1 &
    echo $! > "$DELAY_PID_FILE"
    local i
    for i in $(seq 1 25); do pactl list short sinks | grep -q praxis-delayed && break; sleep 0.1; done
    pactl set-default-sink praxis-delayed 2>/dev/null || return 0
    for i in $(pactl list short sink-inputs | awk '{print $1}'); do
        pactl move-sink-input "$i" praxis-delayed 2>/dev/null || true
    done
    info "this PC's speakers delayed ${ms} ms to stay in step with the viewer"
}
delay_local_off() {
    [ -f "$DELAY_PID_FILE" ] || return 0
    local orig; orig=$(cat "$STATE_DIR/delay.orig" 2>/dev/null || true)
    [ -n "$orig" ] && pactl set-default-sink "$orig" 2>/dev/null || true
    kill "$(cat "$DELAY_PID_FILE")" 2>/dev/null || true
    rm -f "$DELAY_PID_FILE" "$STATE_DIR/delay.orig"
}

# The low-delay path on NVIDIA. wf-recorder only captures, as raw frames;
# GStreamer moves them to the GPU, converts to 4:4:4 there and encodes with
# NVENC in zero-latency mode. Measured screen-to-screen with a frame counter:
# 100-140 ms when wf-recorder encoded (its encoder pipeline holds frames),
# 50-75 ms this way, and the same picture (4:4:4, 45 dB on the test card).
# Sound is a second stream in the same MPEG-TS; the muxer is told not to
# wait for it (latency=0), so it never holds a video frame back.
start_stream_gst() {
    local mon="$1" inner="$2" fps="$3" wh
    wh=$(monitors | python3 -c 'import json,sys
m=[m for m in json.load(sys.stdin) if m["name"]==sys.argv[1]][0]; print(m["width"], m["height"])' "$mon")
    local w=${wh% *} h=${wh#* }
    local br=${SHARE_BITRATE:-30M}; local kbps=$(( ${br%M} * 1000 ))
    # A keyframe every 2 s, not every 30 frames: at 120 fps that was four a
    # second, each squeezed into a one-frame CBR budget, and the picture
    # visibly broke up and rebuilt — the "bursting pixels". The VBV buffer
    # holds 8 frames, so a keyframe can be big enough to arrive sharp; on a
    # LAN it drains in a few milliseconds.
    # wf-recorder quits whenever its screen is reconfigured — moving it in
    # the Arrange view did that, and the far screen went black. So capture
    # runs in a loop that starts it again at once, and the loop holds the
    # FIFO open itself so the encoder never sees end-of-stream in between.
    # Raw frames are whole frames, so the restarted capture lines up again.
    setsid bash -c '
        exec 7<>"$1"
        trap "kill \$c 2>/dev/null; exit 0" INT TERM
        while :; do
            wf-recorder -y -D -o "$2" -c rawvideo -m rawvideo -x bgr0 -f "$1" & c=$!
            wait $c
            # the screen is gone (sharing stopped): stop, do not spin forever
            hyprctl -j monitors 2>/dev/null | grep -q "\"$2\"" || exit 0
            sleep 0.2
        done' capture "$FIFO" "$mon" >"$STATE_DIR/capture.log" 2>&1 &
    echo $! > "$PID_FILE"
    local -a audio=()
    if [ "$WITH_AUDIO" = 1 ]; then
        delay_local_on
        local src; src=$(default_monitor || true)
        # uncompressed 48 kHz stereo (1.5 Mb/s): no codec delay, and on its
        # own loopback port so it can never hold a picture frame back
        [ -n "$src" ] && audio=(pulsesrc device="$src" do-timestamp=true buffer-time=20000 latency-time=5000
            ! audioconvert ! audioresample ! "audio/x-raw,format=S16BE,rate=48000,channels=2"
            ! rtpL16pay mtu=1400 ! rtpstreampay ! tcpserversink host=127.0.0.1 port=$(( inner + 1 )) sync=false)
    fi
    info "encoding on the GPU: ${w}x${h} 4:4:4 at $fps fps, $br"
    echo hevc-rtp > "$STATE_DIR/codec"
    # RTP, not MPEG-TS: every RTP frame ends with a marker, so the viewer
    # decodes it the moment its last packet lands. An MPEG-TS demuxer only
    # releases a frame once the next one starts — that alone was ~25 ms.
    # leaky only on raw frames (dropping one is harmless); never after encode
    setsid gst-launch-1.0 -q \
        filesrc location="$FIFO" blocksize=$(( w * h * 4 )) \
        ! rawvideoparse width="$w" height="$h" format=bgrx framerate="$fps/1" \
        ! queue leaky=downstream max-size-buffers=1 max-size-bytes=0 max-size-time=0 \
        ! cudaupload ! cudaconvert ! "video/x-raw(memory:CUDAMemory),format=Y444" \
        ! nvh265enc preset=p1 tune=ultra-low-latency zerolatency=true bframes=0 \
            gop-size=$(( fps * 2 )) rc-mode=cbr bitrate="$kbps" \
            vbv-buffer-size=$(( kbps * 8 / fps )) spatial-aq=true \
        ! rtph265pay config-interval=-1 mtu=8192 ! rtpstreampay \
        ! tcpserversink host=127.0.0.1 port="$inner" sync=false \
        "${audio[@]}" >"$STATE_DIR/serve.log" 2>&1 &
    echo $! > "$SERVE_PID_FILE"
}

# Viewer for the RTP stream (see start_stream_gst). Sound comes over its own
# link — a second gate connection to the host's next port — and plays with
# a short buffer, separate from the picture so neither waits on the other.
# The viewer draws the host's pointer itself (see cursor_send in
# praxis-share-gate): a click-through overlay above the fullscreen picture,
# moved by position updates over UDP, so it moves at this screen's own
# refresh rate instead of with the video's frames.
start_cursor_overlay() {
    command -v quickshell >/dev/null || return 0
    local out="$1" qml="$STATE_DIR/cursor-overlay.qml"
    local png="$STATE_DIR/pointer.png" pw=48 ph=48 phx=6 phy=2 geo
    geo=$(praxis-share-gate pointer-png "$png" 2>/dev/null) && read -r pw ph phx phy <<<"$geo"
    cat > "$qml" <<QML
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
ShellRoot {
    PanelWindow {
        id: w
        screen: Quickshell.screens.find(s => s.name === "$out") || Quickshell.screens[0]
        anchors { left: true; right: true; top: true; bottom: true }
        exclusionMode: ExclusionMode.Ignore
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "praxis-cursor"
        WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
        color: "transparent"
        mask: Region {}
        // the picture is shown 1:1 in physical pixels; this window is laid
        // out in logical ones
        readonly property real k: 1 / (screen ? screen.devicePixelRatio : 1)
        // the desktop's own arrow, from the icon theme, so it looks exactly
        // like the pointer on the PC it belongs to
        Image {
            id: ptr
            visible: false
            source: "file://$png"
            smooth: true; mipmap: true
            property real px: 24                       // its size on screen, from the host
            width: px * w.k * $pw / 48; height: px * w.k * $ph / 48
            property real hx: $phx * width / $pw; property real hy: $phy * height / $ph
        }
        Process {
            running: true
            command: ["praxis-share-gate", "cursor-recv"]
            stdout: SplitParser {
                onRead: data => {
                    const p = data.split(" ")
                    if (p.length > 3) ptr.px = Number(p[3])
                    ptr.x = Number(p[0]) * w.k - ptr.hx
                    ptr.y = Number(p[1]) * w.k - ptr.hy
                    ptr.visible = p[2] === "1"
                }
            }
        }
    }
}
QML
    setsid quickshell -p "$qml" >"$STATE_DIR/cursor-overlay.log" 2>&1 &
    CURSOR_PID=$!
}

view_rtp() {
    # A live wallpaper behind a fullscreen picture is decoding video nobody
    # can see (~30 % CPU); show the still while watching, put it back after.
    local wp_paused=""
    if pgrep -x mpvpaper >/dev/null && command -v praxis-wallpaper >/dev/null; then
        praxis-wallpaper suspend >/dev/null 2>&1 && wp_paused=1
    fi
    # Sound: a small fixed playback buffer that pushes back, and a queue that
    # drops what is late, measured in BYTES (20 ms of 48 kHz stereo). These
    # buffers carry no timestamps, so a queue limited by time never counted
    # as full and never dropped anything; with a sink that takes everything
    # (pulsesink, unsynced) the Omen ended up playing 0.8-1.2 s behind. Now
    # the whole path measures ~60 ms, which the host's in-step delay matches.
    local async="alsasink device=pipewire buffer-time=40000 latency-time=10000 sync=false"
    aplay -L 2>/dev/null | grep -qx pipewire || async="$asink sync=false buffer-time=40000 latency-time=10000"
    local dec="nvh265dec max-display-delay=0"
    gst-inspect-1.0 nvh265dec >/dev/null 2>&1 || dec="avdec_h265"
    start_cursor_overlay "${myout:-}"
    echo "$target" > "$STATE_DIR/viewer.target"
    gst-launch-1.0 -q \
        tcpclientsrc host=127.0.0.1 port="$local_port" \
        ! "application/x-rtp-stream,encoding-name=H265" ! rtpstreamdepay \
        ! "application/x-rtp,media=video,clock-rate=90000,encoding-name=H265" \
        ! rtph265depay ! h265parse ! $dec \
        ! queue leaky=downstream max-size-buffers=1 \
        ! $vconv ! $vsink sync=false async=false &
    VIEW_PID=$!; VIEW_GATE=$gate; VIEW_AUDIO=""
    setsid praxis-share-gate client --host "$host" --port "$port" --listen $(( local_port + 1 )) \
        --code "$code" --audio >"$STATE_DIR/client-audio.log" 2>&1 &
    local agate=$!
    ( sleep 1
      exec gst-launch-1.0 -q tcpclientsrc host=127.0.0.1 port=$(( local_port + 1 )) \
        ! "application/x-rtp-stream,media=audio,clock-rate=48000,encoding-name=L16,channels=2" ! rtpstreamdepay \
        ! "application/x-rtp,media=audio,clock-rate=48000,encoding-name=L16,channels=2" \
        ! rtpL16depay ! audioconvert ! audioresample \
        ! queue leaky=downstream max-size-buffers=0 max-size-bytes=3840 max-size-time=0 \
        ! $async
    ) >"$STATE_DIR/viewer-audio.log" 2>&1 &
    VIEW_AUDIO="$agate $!"
    echo "$VIEW_GATE $VIEW_PID $VIEW_AUDIO" > "$STATE_DIR/viewer.pids"
    WP_PAUSED=$wp_paused
    trap 'kill ${VIEW_GATE:-} ${VIEW_PID:-} ${VIEW_AUDIO:-} ${CURSOR_PID:-} 2>/dev/null || true; rm -f "$STATE_DIR/viewer.pids" "$STATE_DIR/viewer.target"; [ -n "${WP_PAUSED:-}" ] && praxis-wallpaper restore >/dev/null 2>&1' EXIT INT TERM
    wait "$VIEW_PID" || true
}

cmd_connect() {
    local target="" code=""
    while [ $# -gt 0 ]; do case "$1" in
        --code) code="$2"; shift 2 ;;
        *) target="$1"; shift ;;
    esac; done
    [ -n "$target" ] || die "usage: praxis-share connect HOST[:PORT] [--code NNNNNN]"
    local host="${target%%:*}" port="${target##*:}"
    [ "$port" = "$host" ] && port="$DEFAULT_PORT"
    need gst-launch-1.0; need praxis-share-gate

    # Check receiver requirements before connecting so missing plugins are immediately obvious
    local missing=()
    gst-inspect-1.0 tsdemux >/dev/null 2>&1 || missing+=("tsdemux (gst-plugins-bad)")
    gst-inspect-1.0 h264parse >/dev/null 2>&1 || missing+=("h264parse (gst-plugins-bad)")
    gst-inspect-1.0 avdec_h264 >/dev/null 2>&1 || missing+=("avdec_h264 (gst-libav)")
    if [ ${#missing[@]} -gt 0 ]; then
        printf '\n\033[31m✗ This machine is missing media decoders needed to view shared screens:\033[0m\n' >&2
        for m in "${missing[@]}"; do
            printf '  • %s\n' "$m" >&2
        done
        printf '\nTo install them on this machine, run:\n' >&2
        printf '  \033[1;32msudo pacman -S --needed gst-plugins-bad gst-libav gst-plugins-good\033[0m\n\n' >&2
        if [ -t 0 ] || [ -t 1 ]; then
            read -p "Press Enter to exit..." _ || true
        fi
        exit 1
    fi

    local vsink="waylandsink fullscreen=true"
    if [ -z "${WAYLAND_DISPLAY:-}" ] || ! gst-inspect-1.0 waylandsink >/dev/null 2>&1; then
        vsink="autovideosink"
    fi

    # Colour conversion for display on the GPU. GStreamer's CPU videoconvert
    # maps TV-range video 2 levels dark (255 -> 253, 127 -> 125) — faded
    # colour on the far screen; glcolorconvert comes back exact.
    local vconv="glupload ! glcolorconvert ! video/x-raw(memory:GLMemory),format=RGBA ! gldownload ! video/x-raw,format=RGBA"
    gst-inspect-1.0 glcolorconvert >/dev/null 2>&1 || vconv="videoconvert ! video/x-raw,format=BGRx"

    local asink="pulsesink"
    if ! gst-inspect-1.0 pulsesink >/dev/null 2>&1; then
        asink="autoaudiosink"
    fi

    [ -z "$code" ] && [ "${PRAXIS_SHARE_PIN:-0}" != 1 ] && code="$OPEN_CODE"
    if [ -z "$code" ]; then
        # asked for rather than guessed: the host is showing it on its screen
        printf 'pairing code shown on %s: ' "$host"
        read -r code
    fi
    [ -n "$code" ] || die "no code given"

    # Auto-correct common subnet octet typo (e.g. typing 10.255 when on 10.225)
    local my_sub
    my_sub=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d. -f1-2 | head -1)
    if [ -n "$my_sub" ] && [[ "$host" =~ ^10\.255\.(.*) ]] && [[ "$my_sub" == 10.* ]] && [[ "$my_sub" != "10.255" ]]; then
        local fixed_host="${my_sub}.${host#10.255.}"
        if (exec 3<>/dev/tcp/"$fixed_host"/"$port") 2>/dev/null; then
            exec 3<&- 3>&-
            info "auto-correcting typo in host address: $host -> $fixed_host"
            host="$fixed_host"
        fi
    fi

    local local_port=$(( port + 2000 ))
    mkdir -p "$STATE_DIR"
    info "connecting to $host:$port"
    # this screen's real pixels and refresh, so the host builds a matching
    # display; capped at 120 Hz
    local myres; myres=$(monitors | python3 -c 'import json,sys
ms=[m for m in json.load(sys.stdin) if not m["name"].startswith("HEADLESS")]
m=next((m for m in ms if m.get("focused")), ms[0] if ms else None)
if m: print("%s %dx%d@%d s%g m%d" % (m["name"], m["width"], m["height"], min(120, round(m["refreshRate"])), m["scale"], m.get("physicalWidth") or 0))' 2>/dev/null || true)
    # open the picture on that real screen, never on a virtual one left over
    # from sharing this PC, where it would be invisible
    local myout="${myres%% *}"; myres="${myres#* }"
    # tests: show the picture on a given output instead
    [ -n "${PRAXIS_SHARE_VIEW_ON:-}" ] && { myout=$PRAXIS_SHARE_VIEW_ON; myres="1920x1080@120 s1 m0"; }
    [ -n "$myout" ] && hyprctl dispatch "hl.dsp.focus({monitor=\"$myout\"})" >/dev/null 2>&1 || true
    setsid praxis-share-gate client --host "$host" --port "$port" \
        --listen "$local_port" --code "$code" ${myres:+--res "$myres"} >"$STATE_DIR/client.log" 2>&1 &
    local gate=$! i
    # wait for the link (and the host's codec line) rather than a fixed nap
    for i in $(seq 1 40); do
        grep -q "play from" "$STATE_DIR/client.log" 2>/dev/null && break
        kill -0 "$gate" 2>/dev/null || break
        sleep 0.25
    done
    if ! kill -0 "$gate" 2>/dev/null; then
        printf '\n'; sed 's/^/  /' "$STATE_DIR/client.log" 2>/dev/null | tail -3
        die "could not connect"
    fi
    ok "connected — Super+C closes the picture, Super+Alt+D disconnects"

    # The decoder now reads from the authenticated tunnel on loopback, not
    # from the network: everything over the wire is inside the TLS session
    # the pairing code established.
    # BGRx before the sink: handed YUV, the compositor colour-manages the
    # surface as video, which on a wide-gamut panel washed it out next to
    # every other window. As plain RGB it is treated like any other app.
    #
    # Leaky queues and async=false are what make a window appear at all.
    # Where to drop, and where never to: compressed video is never dropped —
    # losing part of it corrupts every frame up to the next keyframe, which
    # showed as blocks bursting across the picture. Only *decoded* frames are
    # dropped, by the one-frame leaky queue after the decoder: harmless, and
    # it means the newest frame is always the one on screen. Slice threading
    # keeps the decoder from holding frames back (frame threading adds a few
    # frames of delay), output-corrupt=false never shows a damaged frame, and
    # the audio branch stays leaky so it can never block the demuxer.
    #
    # 100 ms each: a leaky queue drops the oldest data instead of blocking,
    # so it can be small without bringing back the preroll deadlock, and a
    # 1 s queue had been adding up to a second of input delay.
    # A viewer that joins mid-stream drops video until the next keyframe;
    # meanwhile the small audio queue filled, blocked the demuxer, and the
    # keyframe never arrived — the pipeline sat in PREROLLING forever with
    # no window, while saying "connected".
    #
    # The viewer runs in the background and we wait on it, rather than in the
    # foreground: bash does not run a trap while a foreground child is
    # running, so a Disconnect from the window used to leave the picture up
    # until the stream died on its own. With wait, a signal lands at once.
    # The decoder for the codec the host announced. NVDEC with no display
    # delay hands each frame over as soon as it is decoded (by default it
    # holds a few back); without NVIDIA, libav. An older host announces
    # nothing: decodebin3 works it out.
    local codec; codec=$(grep -oE 'codec [a-z0-9-]+' "$STATE_DIR/client.log" 2>/dev/null | awk '{print $2}' | tail -1)
    # each branch named by its track type: gst-launch otherwise hands a
    # demuxer pad to whichever branch takes it first, and with no sound
    # track the video could land on the AAC decoder and show nothing
    local vcaps=""
    case "$codec" in hevc) vcaps="video/x-h265 !" ;; h264) vcaps="video/x-h264 !" ;; esac
    local vdec="decodebin3"
    if [ "$codec" = hevc-rtp ]; then view_rtp; return; fi
    case "$codec" in
        hevc) if gst-inspect-1.0 nvh265dec >/dev/null 2>&1; then vdec="h265parse ! nvh265dec max-display-delay=0"
              else vdec="h265parse ! avdec_h265"; fi ;;
        h264) if gst-inspect-1.0 nvh264dec >/dev/null 2>&1; then vdec="h264parse ! nvh264dec max-display-delay=0"
              else vdec="h264parse ! avdec_h264 output-corrupt=false"; fi ;;
    esac

    echo "$target" > "$STATE_DIR/viewer.target"
    gst-launch-1.0 -q \
        tcpclientsrc host=127.0.0.1 port="$local_port" ! tsdemux name=d latency=0 \
        d. ! $vcaps queue max-size-buffers=0 max-size-bytes=0 max-size-time=0 \
           ! $vdec \
           ! queue leaky=downstream max-size-buffers=1 \
           ! $vconv ! $vsink sync=false async=false \
        d. ! audio/mpeg ! queue leaky=downstream max-size-buffers=0 max-size-bytes=0 max-size-time=100000000 \
           ! aacparse ! avdec_aac ! audioconvert ! audioresample ! $asink sync=false async=false &
    VIEW_PID=$!; VIEW_GATE=$gate
    echo "$VIEW_GATE $VIEW_PID" > "$STATE_DIR/viewer.pids"
    # globals, not locals: an EXIT trap runs after the function has returned,
    # and under set -u a local it names is unbound by then
    trap 'kill "${VIEW_GATE:-}" "${VIEW_PID:-}" 2>/dev/null || true; rm -f "$STATE_DIR/viewer.pids" "$STATE_DIR/viewer.target"' EXIT INT TERM
    set +e
    wait "$VIEW_PID"
    local rc=$?
    set -e
    if [ "$rc" -ne 0 ] && [ "$rc" -lt 128 ]; then
        printf 'stream viewer stopped (exit %d) — praxis-share doctor\n' "$rc" >&2
        return 1
    fi
}

cmd_disconnect() {
    local f="$STATE_DIR/viewer.pids"
    if [ -s "$f" ]; then
        # shellcheck disable=SC2046
        kill $(cat "$f") 2>/dev/null || true
        rm -f "$f" "$STATE_DIR/viewer.target"
    fi
    pkill -f "gst-launch-1.0.*tcpclientsrc" 2>/dev/null || true
    pkill -f "praxis-share-gate client" 2>/dev/null || true
    cmd_input stop >/dev/null 2>&1 || true
    ok "disconnected"
}

# Every window on the shared display goes back to the main screen, so
# stopping a share never strands a window on a display that is about to go.
cmd_bring_back() {
    local mon; mon=$(cat "$MON_FILE" 2>/dev/null || true)
    [ -n "$mon" ] || { info "no shared display"; return 0; }
    local main; main=$(monitors | python3 -c 'import json,sys
for m in json.load(sys.stdin):
    if not m["name"].startswith("HEADLESS"): print(m["name"]); break')
    local addrs; addrs=$(hyprctl -j clients 2>/dev/null | python3 -c "import json,sys
ws={w['id'] for w in json.loads(__import__('subprocess').run(['hyprctl','-j','workspaces'],capture_output=True,text=True).stdout) if w.get('monitor')=='$mon'}
for c in json.load(sys.stdin):
    if c.get('workspace',{}).get('id') in ws: print(c['address'])")
    local n=0 a
    for a in $addrs; do
        hyprctl dispatch "hl.dsp.window.move({ monitor = \"$main\", window = \"address:$a\" })" >/dev/null 2>&1 && n=$((n+1))
    done
    ok "brought $n window(s) back to $main"
}

cmd_stop() {
    [ -s "$MON_FILE" ] && cmd_bring_back >/dev/null 2>&1 || true
    local pid; pid=$(serving_pid || true)
    if [ -n "$pid" ]; then kill -INT "$pid" 2>/dev/null || true; ok "stopped capturing"; else info "not serving"; fi
    # The capture runs as its own process group (a restart loop around
    # wf-recorder). Signalling only the loop left wf-recorder behind, still
    # capturing — and an old one kept spinning on a screen that no longer
    # existed, eating CPU. End the whole group, forcefully if it lingers.
    if [ -f "$PID_FILE" ]; then
        local g; g=$(cat "$PID_FILE")
        kill -TERM -- "-$g" 2>/dev/null || true
        sleep 0.3
        kill -KILL -- "-$g" 2>/dev/null || true
    fi
    # "|| true" on every kill: under set -e, killing a process that already
    # exited returns 1 and aborted stop on this line — so the gate below it
    # was never killed, kept the old PIN, and every later start said
    # "already serving".
    [ -f "$SERVE_PID_FILE" ] && { kill "$(cat "$SERVE_PID_FILE")" 2>/dev/null || true; }
    [ -f "$GATE_PID_FILE" ] && { kill "$(cat "$GATE_PID_FILE")" 2>/dev/null || true; }
    rm -f "$PID_FILE" "$SERVE_PID_FILE" "$GATE_PID_FILE" "$PORT_FILE" "$CODE_FILE" "$FIFO" "$STATE_DIR/clients.json" "$STATE_DIR/mode" "$STATE_DIR/res" "$STATE_DIR/scale" "$STATE_DIR/mirror_out"
    input_running && info "input is still shared — praxis-share input stop"
    if [ -s "$MON_FILE" ]; then
        local mon; mon=$(cat "$MON_FILE")
        hyprctl output remove "$mon" >/dev/null 2>&1 && ok "removed $mon"
    fi
    rm -f "$MON_FILE"
    delay_local_off
    [ -f "$STATE_DIR/cursor.pid" ] && { kill "$(cat "$STATE_DIR/cursor.pid")" 2>/dev/null || true; rm -f "$STATE_DIR/cursor.pid"; }
    hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1 || true
    command -v praxis-mouse >/dev/null && praxis-mouse resume >/dev/null 2>&1 || true
}

# Put the screens side by side in the given order, left to right, tops
# aligned — what the Arrange strip in the Share window sends after a drag.
# The order is remembered so the extra display goes back to its place the
# next time a viewer connects ("SHARED" stands for it while it does not
# exist yet).
ORDER_FILE="$HOME/.config/praxis/screen-order"
cmd_arrange() {
    [ $# -ge 1 ] || die "usage: praxis-share arrange OUTPUT..."
    mkdir -p "${ORDER_FILE%/*}"
    local -a order=("$@")
    # remember the shared screen by role, not by its HEADLESS-n name
    local saved=() n mon; mon=$(cat "$MON_FILE" 2>/dev/null || true)
    for n in "${order[@]}"; do [ "$n" = "$mon" ] || [[ "$n" == HEADLESS-* ]] && saved+=("SHARED") || saved+=("$n"); done
    printf '%s\n' "${saved[@]}" > "$ORDER_FILE"; rm -f "$ORDER_FILE.pos"
    apply_order "${order[@]}"
}
apply_order() {
    monitors | python3 -c '
import json, sys, subprocess
order = sys.argv[1:]
ms = {m["name"]: m for m in json.load(sys.stdin)}
x = 0
lua = []
for n in order:
    m = ms.get(n)
    if not m:
        continue
    mode = "%dx%d@%.3f" % (m["width"], m["height"], m["refreshRate"])
    lua.append("hl.monitor({ output = \"%s\", mode = \"%s\", position = \"%dx0\", scale = %g })" % (n, mode, x, m["scale"]))
    x += round(m["width"] / m["scale"])
# every screen in one eval: moved one by one they overlap for a moment and
# Hyprland flashes a "monitor layout is set up incorrectly" warning
# Two steps: first park every screen far apart, then put each in place.
# Hyprland applies each position as it comes, so moving straight
# to the new layout overlapped for a moment — the "monitor layout is set
# up incorrectly" warning — whenever a screen moved past another.
park = [__import__("re").sub(r"position = \"[^\"]*\"", "position = \"%dx0\"" % (100000 + 20000 * i), l) for i, l in enumerate(lua)]
subprocess.run(["hyprctl", "eval", "\n".join(park)], stdout=subprocess.DEVNULL)
subprocess.run(["hyprctl", "eval", "\n".join(lua)], stdout=subprocess.DEVNULL)
' "$@"
}
# praxis-share place NAME=X,Y ... — exact positions in logical pixels, from
# the drag-to-arrange view. Remembered like arrange, with the extra display
# saved as SHARED so it goes back there next time.
cmd_place() {
    [ $# -ge 1 ] || die "usage: praxis-share place OUTPUT=X,Y ..."
    mkdir -p "${ORDER_FILE%/*}"
    local mon; mon=$(cat "$MON_FILE" 2>/dev/null || true)
    local kv n; : > "$ORDER_FILE.pos"
    for kv in "$@"; do
        n=${kv%%=*}
        { [ "$n" = "$mon" ] || [[ "$n" == HEADLESS-* ]]; } && n=SHARED
        echo "$n=${kv#*=}" >> "$ORDER_FILE.pos"
    done
    rm -f "$ORDER_FILE"
    apply_place "$@"
}
apply_place() {
    monitors | python3 -c '
import json, sys, subprocess
ms = {m["name"]: m for m in json.load(sys.stdin)}
lua = []
for kv in sys.argv[1:]:
    n, xy = kv.split("=", 1)
    x, y = (int(float(v)) for v in xy.split(","))
    m = ms.get(n)
    if not m:
        continue
    mode = "%dx%d@%.3f" % (m["width"], m["height"], m["refreshRate"])
    lua.append("hl.monitor({ output = \"%s\", mode = \"%s\", position = \"%dx%d\", scale = %g })" % (n, mode, x, y, m["scale"]))
# Two steps: first park every screen far apart, then put each in place.
# Hyprland applies each position as it comes, so moving straight
# to the new layout overlapped for a moment — the "monitor layout is set
# up incorrectly" warning — whenever a screen moved past another.
park = [__import__("re").sub(r"position = \"[^\"]*\"", "position = \"%dx0\"" % (100000 + 20000 * i), l) for i, l in enumerate(lua)]
subprocess.run(["hyprctl", "eval", "\n".join(park)], stdout=subprocess.DEVNULL)
subprocess.run(["hyprctl", "eval", "\n".join(lua)], stdout=subprocess.DEVNULL)
' "$@"
}
# place a just-created extra display where the user last put it
place_shared() {
    local new="$1" n order=()
    if [ -s "$ORDER_FILE.pos" ]; then
        local -a args=(); local kv
        while read -r kv; do [ "${kv%%=*}" = SHARED ] && args+=("$new=${kv#*=}") || args+=("$kv"); done < "$ORDER_FILE.pos"
        apply_place "${args[@]}"; return 0
    fi
    [ -s "$ORDER_FILE" ] || return 0
    while read -r n; do [ "$n" = SHARED ] && order+=("$new") || order+=("$n"); done < "$ORDER_FILE"
    # screens plugged in since then go on the right
    for n in $(monitors | python3 -c 'import json,sys;print(" ".join(m["name"] for m in json.load(sys.stdin)))'); do
        [[ " ${order[*]} " == *" $n "* ]] || order+=("$n")
    done
    apply_order "${order[@]}"
}

cmd_status() {
    local pid; pid=$(serving_pid || true)
    if [ -n "$pid" ]; then
        ok "serving on port $(cat "$PORT_FILE" 2>/dev/null || echo '?')  (pid $pid)"
        [ -s "$MON_FILE" ] && info "virtual display: $(cat "$MON_FILE")"
        [ -s "$CODE_FILE" ] && printf '  pairing code  \033[1m%s\033[0m\n' "$(cat "$CODE_FILE")"
    else
        info "not serving"
    fi
    printf '\n\033[1mdisplays\033[0m\n'
    local out
    if ! out=$(monitors); then
        echo "  (Hyprland not reachable)"; return
    fi
    printf '%s' "$out" | python3 -c '
import json, sys
for m in json.load(sys.stdin):
    name = m["name"]
    kind = "virtual" if name.startswith("HEADLESS") else "physical"
    print("  %-12s %dx%d@%.0f  scale %s  (%s)"
          % (name, m["width"], m["height"], m["refreshRate"], m["scale"], kind))
'
}

# ── keyboard and mouse across machines ──────────────────────────────────
# Separate from the video on purpose. The virtual display is a real output
# of this compositor, so windows moved onto it are already driven by this
# keyboard — nothing to forward. What is missing is the other direction:
# one keyboard and mouse reaching the other machine's own desktop. That is
# what deskflow does, and it needs a screen layout naming both sides.
# -s names the settings file; the screen layout is read from
# deskflow-server.conf sitting beside it, not from -s itself.
DESKFLOW_SETTINGS="$STATE_DIR/deskflow.conf"
DESKFLOW_CONF="$STATE_DIR/deskflow-server.conf"
INPUT_PID_FILE="$STATE_DIR/input.pid"

write_deskflow_conf() {   # here there side
    # Deskflow 1.27 moved the screen list out of the server config and into
    # the settings file; a server config that still declares screens is
    # ignored with a warning, and its links then fail with "unknown computer
    # name". So the neighbours are declared here, in the INI.
    local opposite
    case "$3" in right) opposite=left ;; left) opposite=right ;; up) opposite=down ;; *) opposite=up ;; esac
    cat >"$DESKFLOW_SETTINGS" <<INI
[General]
$3=$2
screenSaverSync=false

[core]
computerName=$1

[log]
level=Info
INI
    cat >"$DESKFLOW_CONF" <<CONF
section: options
    screenSaverSync = false
    switchCorners = none
end
CONF
    printf '%s\n' "$opposite" >/dev/null   # kept for symmetry on the far side
}

input_running() { [ -f "$INPUT_PID_FILE" ] && kill -0 "$(cat "$INPUT_PID_FILE")" 2>/dev/null; }

cmd_input() {
    local sub="${1:-status}"; shift || true
    case "$sub" in
        host)
            local side=right peer=""
            while [ $# -gt 0 ]; do case "$1" in
                --side) side="$2"; shift 2 ;;
                --peer) peer="$2"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac; done
            command -v deskflow-core >/dev/null || die "deskflow is not installed"
            input_running && die "input is already shared — praxis-share input stop"
            [ -n "$peer" ] || peer="praxis-peer"
            local me; me=$(uname -n)
            write_deskflow_conf "$me" "$peer" "$side"
            setsid deskflow-core server --new-instance -s "$DESKFLOW_SETTINGS" \
                >"$STATE_DIR/input.log" 2>&1 &
            echo $! > "$INPUT_PID_FILE"
            sleep 1.5
            input_running || { tail -4 "$STATE_DIR/input.log" 2>/dev/null; die "deskflow did not start"; }
            ok "sharing this keyboard and mouse — the other machine is to the $side"
            info "on it:  praxis-share input join $(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
            ;;
        join)
            local host="${1:-}"; [ -n "$host" ] || die "usage: praxis-share input join HOST"
            command -v deskflow-core >/dev/null || die "deskflow is not installed"
            input_running && die "already joined — praxis-share input stop"
            setsid deskflow-core client --new-instance "$host" \
                >"$STATE_DIR/input.log" 2>&1 &
            echo $! > "$INPUT_PID_FILE"
            sleep 1.5
            input_running || { tail -4 "$STATE_DIR/input.log" 2>/dev/null; die "could not join $host"; }
            ok "taking keyboard and mouse from $host"
            ;;
        stop)
            if input_running; then kill "$(cat "$INPUT_PID_FILE")" 2>/dev/null; ok "input sharing stopped"
            else info "input is not shared"; fi
            rm -f "$INPUT_PID_FILE"
            ;;
        status|"")
            if input_running; then ok "input is shared (pid $(cat "$INPUT_PID_FILE"))"
            else info "input is not shared"; fi
            ;;
        *) die "unknown: praxis-share input $sub" ;;
    esac
}

case "${1:-}" in
    extend)  shift; cmd_extend "$@" ;;
    mirror)  shift; cmd_mirror "$@" ;;
    connect) shift; cmd_connect "$@" ;;
    input)   shift; cmd_input "$@" ;;
    disconnect) cmd_disconnect ;;
    bring-back) cmd_bring_back ;;
    on-connect-stream) cmd_on_connect_stream ;;
    stop)    cmd_stop ;;
    status)  cmd_status ;;
    arrange) shift; cmd_arrange "$@" ;;
    place)   shift; cmd_place "$@" ;;
    sound)
        # praxis-share sound on|off — send the sound to the viewer too, or
        # keep it on this PC's speakers only; remembered for every share
        case "${2:-}" in on|off) ;; *) die "usage: praxis-share sound on|off" ;; esac
        mkdir -p "$HOME/.config/praxis"; echo "$2" > "$HOME/.config/praxis/share-sound"
        ok "shared sound $2 — takes effect the next time sharing starts" ;;
    scale)
        # praxis-share scale 1|1.25|1.5|1.75|2 — text and windows on the shared
        # screen bigger or smaller; remembered, applied at once if sharing
        [[ "${2:-}" =~ ^(1|1\.25|1\.5|1\.75|2)$ ]] || die "usage: praxis-share scale 1|1.25|1.5|1.75|2"
        mkdir -p "$HOME/.config/praxis"; echo "$2" > "$HOME/.config/praxis/share-scale"
        echo "$2" > "$STATE_DIR/scale" 2>/dev/null || true
        mon=$(cat "$MON_FILE" 2>/dev/null || true)
        if [ -n "$mon" ]; then
            res=$(cat "$STATE_DIR/res" 2>/dev/null || echo "$DEFAULT_RES")
            hyprctl eval "hl.monitor({ output = \"$mon\", mode = \"$res\", position = \"auto\", scale = $2 })" >/dev/null
            "$0" restore-layout >/dev/null 2>&1 || true
        fi
        ok "shared screen at $(awk "BEGIN{print $2*100}") %" ;;
    audio-delay)
        # praxis-share audio-delay MS: how long this PC waits so its speakers
        # sound together with the viewer's; applied at once if sharing
        [[ "${2:-}" =~ ^[0-9]+$ ]] && [ "$2" -le 1000 ] || die "usage: praxis-share audio-delay MS (0-1000)"
        mkdir -p "$HOME/.config/praxis"; echo "$2" > "$HOME/.config/praxis/share-audio-delay-ms"
        if [ -f "$DELAY_PID_FILE" ]; then
            orig=$(cat "$STATE_DIR/delay.orig" 2>/dev/null || true)
            kill "$(cat "$DELAY_PID_FILE")" 2>/dev/null || true; rm -f "$DELAY_PID_FILE"
            [ -n "$orig" ] && pactl set-default-sink "$orig" 2>/dev/null; sleep 0.3
            delay_local_on
        fi
        ok "this PC's speakers wait $2 ms for the viewer's" ;;
    restore-layout)
        # After a config reload (which also happens whenever a display
        # setting is saved) Hyprland puts screens back where the config says
        # and resets the shared screen to its defaults, 60 Hz at 200 %. Put
        # the shared screen's mode and scale back first, then the layout.
        shared=$(cat "$MON_FILE" 2>/dev/null || true)
        if [ -n "$shared" ] && monitors | grep -q "\"$shared\""; then
            hyprctl eval "hl.monitor({ output = \"$shared\", mode = \"$(cat "$STATE_DIR/res" 2>/dev/null || echo "$DEFAULT_RES")\", position = \"auto\", scale = $(cat "$STATE_DIR/scale" 2>/dev/null || echo 1) })" >/dev/null 2>&1 || true
        fi
        [ -s "$ORDER_FILE.pos" ] || exit 0
        args=(); shared=$(cat "$MON_FILE" 2>/dev/null || true)
        while read -r kv; do
            if [ "${kv%%=*}" = SHARED ]; then [ -n "$shared" ] && args+=("$shared=${kv#*=}"); else args+=("$kv"); fi
        done < "$ORDER_FILE.pos"
        apply_place "${args[@]}" ;;
    scan)    shift; praxis-share-gate scan "$@" ;;
    doctor)  doctor ;;
    ""|-h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $1  (try: praxis-share help)" ;;
esac
